# Settings for comfofan.service. Install as /etc/homeautomation/comfofan.env, root:root 0600:
#   sudo install -m 600 -o root -g root comfofan.env.example /etc/homeautomation/comfofan.env
# Comments must be on their own line (systemd does not support inline comments).

# --- Output ----------------------------------------------------------------------------------
# Speed input range of the ventilation unit: 0-10 (default) or 1-10. 1..100 % map onto this range,
# off is always 0 V.
COMFOFAN_VOLTAGE_RANGE=0-10

# --- MQTT ------------------------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=comfofan
MQTT_PASSWORD=<redacted>

# --- Home Assistant MQTT discovery -----------------------------------------------------------
HA_DISCOVERY_PREFIX=homeassistant
